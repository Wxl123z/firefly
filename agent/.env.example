# ============ 身份 ============
# agent 的名字。留空则用 config.py 里的默认值。
NAME=

# ============ 聊天模型 ============
# 任何 OpenAI 兼容端点都行：云端（OpenAI / 硅基流动 / DeepSeek…）或本地
# （Ollama 的 /v1、vLLM 的 /v1）。下面是占位值，换成你自己的。
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
CHAT_API_KEY=sk-替换成你自己的

# 思考模型（Qwen3.5 / DeepSeek-R1 等）开关。低延迟场景建议关。
ENABLE_THINKING=false
# 思考开关的传参方式：
#   top_level            云端 OpenAI 兼容，顶层 enable_thinking
#   chat_template_kwargs 本地 vLLM 起 Qwen
#   none                 不传（Ollama）
THINKING_PARAM_STYLE=top_level

# ============ 嵌入模型 ============
# 走 OpenAI 兼容的 /embeddings。留空则跟随上面的 CHAT_BASE_URL / CHAT_API_KEY。
# 本地 Ollama 就填 http://localhost:11434/v1 —— 同一条代码路径。
EMBED_MODEL=BAAI/bge-m3
# EMBED_BASE_URL=
# EMBED_API_KEY=
# EMBED_DIM=1024

# ============ 注意力：下面这些改错了不会报错，只会让行为变怪 ============

# ---- 上下文与压缩 ----
# 本地部署时改成模型的实际窗口。
CTX_WINDOW=131072
CTX_WARN_RATIO=0.60          # 尾部通知开始提醒的占用率
CTX_FORCE_RATIO=0.80         # 到这个占用率就强制压缩
COMPRESS_KEEP_TOKENS=4000    # 压缩时保留多少近期 token
COMPRESS_MIN_GAIN_TOKENS=2000
COMPRESS_COOLDOWN_TURNS=3

# ---- Agent 循环 ----
MAX_REACT_STEPS=8            # 助手 Profile 的单回合步数上限
CODING_MAX_STEPS=40          # 编码 Profile 的单回合要长得多
MAX_OUTPUT_TOKENS=1024
CODING_MAX_OUTPUT_TOKENS=8192
TOOL_RESULT_MAX_TOKENS=3000  # 工具结果回灌上限（超了截中间、保头尾）
TOOL_SEARCH_TOP_K=6

# ---- 编码 Profile ----
# 留空则取项目根（BASE_DIR 的上一级）。--workspace 可临时覆盖。
# CODING_WORKSPACE=D:/some/project
# 审批档：auto（全自动）/ destructive（只问危险操作，默认）/ all_writes（写操作都问）
APPROVAL_POLICY=destructive
# 默认不许编码 agent 改自己（源码目录只读）。要自举改自己就打开它 —— 有 git 兜底。
ALLOW_SELF_EDIT=false
# 留空则自动探测：pwsh → powershell → cmd（POSIX 上是 /bin/bash -lc）
# SHELL_COMMAND=

# ---- 存储 ----
MILVUS_MODE=lite             # lite=嵌入式 | standalone=http://localhost:19530
COLLECTION_NAME=agent_memory
MESSAGE_INDEX_COLLECTION=message_index
# DB_PATH=data/agent.db
# DB_URL=postgresql://user:pass@localhost:5432/agent

# ---- 记忆 ----
MEMORY_MIN_CONFIDENCE=0.6    # 低于此置信度只进 QUESTIONS.md，不进 Wiki 正文
INFERENCE_SUPPORT_THRESHOLD=2

# ---- 知识库（Wiki）----
# 主题归并阈值。0.72 是拿真实主题分布扫出来的，别凭感觉改。
WIKI_MERGE_SIMILARITY=0.72
WIKI_USE_LLM=true
WIKI_BUILD_ON_EXIT=true

# ---- 离线任务（全部在退出时执行，启动是纯读取）----
OFFLINE_ON_EXIT=true
OFFLINE_ROLLUP_DAYS=3
OFFLINE_KEEP_TOKENS=8000

# ---- 其它 ----
# 本地 Qwen tokenizer 目录；留空则退化为字符估算（用 API 返回的 usage 在线校准）
# TOKENIZER_PATH=D:/models/Qwen3.5-27B
